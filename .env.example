# ------------------------------
# LLM Configuration
# ------------------------------

# Base URL for LLM service
# Default: Ollama running locally
LLM_BASE_URL=http://localhost:11434

# Default local model used for RAG
LLM_MODEL=qwen2.5:3b

# Only required for OpenAI option
LLM_API_KEY=

# ------------------------------
# RAG Configuration
# ------------------------------

# Default number of documents retrieved
DEFAULT_CONTEXT_DOCS=3

# Default temperature for generation
DEFAULT_TEMPERATURE=0.7

# Maximum allowed documents in UI slider
MAX_CONTEXT_DOCS=10

# ------------------------------
# App Configuration
# ------------------------------

PORT=8081